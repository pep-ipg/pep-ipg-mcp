{
  "name": "pep-ipg-mcp",
  "version": "1.2.5",
  "description": "MCP server for the Pasargad Electronic Payment internet gateway (Dorsa protocol v28) — docs, endpoint contracts and error codes for AI coding assistants",
  "type": "module",
  "bin": {
    "pep-ipg-mcp": "dist/stdio.js",
    "pep-ipg-sandbox": "dist/sandbox-cli.js"
  },
  "files": [
    "dist",
    "data",
    "!dist/**/*.map"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "start:stdio": "node dist/stdio.js",
    "dev": "tsx watch src/server.ts",
    "test": "tsx --test test/*.test.ts",
    "inspect": "npx @modelcontextprotocol/inspector node dist/stdio.js",
    "prepublishOnly": "npm run build && npm test",
    "build:skill": "node scripts/build-skill.mjs",
    "sandbox": "node dist/sandbox-cli.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "express": "^4.21.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "license": "MIT",
  "author": "Pasargad Electronic Payment Co.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pep-ipg/pep-ipg-mcp.git"
  },
  "homepage": "https://github.com/pep-ipg/pep-ipg-mcp#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "pasargad",
    "pep",
    "ipg",
    "payment-gateway",
    "iran",
    "dorsa",
    "claude",
    "cursor"
  ],
  "publishConfig": {
    "access": "public"
  },
  "contributors": [
    "Mehdi Faraji"
  ]
}
