          "name": "urlId",
          "type": "string",
          "req": "M",
          "desc": "urlId پاسخ خرید"
        },
        {
          "name": "checkVerify",
          "type": "boolean",
          "req": "O",
          "desc": "مانند verify"
        }
      ],
      "request": {
        "checkVerify": true,
        "invoice": "20301112123",
        "urlId": "55358de10d025f49050e9913e7ca425d20185eb2000000001234567"
      },
      "response": {
        "data": {
          "invoice": "20301112123",
