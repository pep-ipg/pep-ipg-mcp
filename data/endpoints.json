      "path": "/token/getToken",
      "auth": "none",
      "group": "auth",
      "summary": "با نام کاربری و رمز عبور ترمینال یک JWT دریافت می‌شود که در همه سرویس‌های بعدی در هدر Authorization: Bearer <token> ارسال می‌شود. اعتبار پیش‌فرض ۱۰ دقیقه است (از claim exp توکن قابل استخراج است). با دریافت 401 مجدداً احراز هویت کنید.",
      "fields": [
        {
          "name": "username",
          "type": "string",
          "req": "M",
          "desc": "نام کاربری سرویس"
        },
        {
          "name": "password",
          "type": "string",
          "req": "M",
          "desc": "رمز عبور سرویس"
        }
      ],
      "request": {
        "username": "<USERNAME>",
        "password": "<PASSWORD>"
      },
      "response": {
        "resultMsg": "Successful",
        "resultCode": 0,
        "token": "<JWT>",
        "username": "<USERNAME>",
        "firstName": "firstName",
        "lastName": "lastName",
        "userId": "17",
        "roles": [
          {
            "authority": "mpg"
          },
          {
            "authority": "merchant"
          }
        ]
      }
    },
