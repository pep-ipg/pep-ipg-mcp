    {
      "id": "verify-transactions",
      "title": "تاییدیه با مهلت زمانی (verify)",
      "path": "/api/payment/verify-transactions",
      "auth": "bearer",
      "group": "settlement",
      "summary": "پس از بازگشت کاربر باید verify ارسال شود؛ در غیر این صورت وجه به مشتری برمی‌گردد. تا پایان مهلت توافقی، پذیرنده همچنان می‌تواند reverse کند و پس از آن سوییچ تراکنش را خودکار confirm می‌کند. پاسخ فقط پیام موفقیت دارد؛ برای جزئیات از verify-payment استفاده کنید. با checkVerify=true، verify تکراری خطای 13428 می‌گیرد.",
      "fields": [
        {
          "name": "invoice",
          "type": "string",
          "req": "M",
          "desc": "شماره فاکتور"
        },
        {
          "name": "urlId",
          "type": "string",
          "req": "M",
          "desc": "urlId پاسخ خرید"
        },
        {
          "name": "checkVerify",
          "type": "boolean",
          "req": "O",
          "desc": "true: verify تکراری خطای 13428 برگرداند؛ false/خالی: پاسخ موفق"
        }
      ],
      "request": {
        "checkVerify": true,
        "invoice": "2030111212",
        "urlId": "291fc237b92f43fbf8f51616d2d670149312c0fb000000001234567"
      },
      "response": {
        "data": "تراکنش موفق است",
        "resultMsg": "Successful",
        "resultCode": 0
      }
    },
